{
  "manifest_version": 3,
  "name": "SoundMesh 画面延后",
  "version": "1.3.0",
  "description": "在任何网站（YouTube、各种影音网站）把画面自动延后，和 SoundMesh 的声音对齐；也能直接把分页声音送进 SoundMesh（没有共享提示条）。",
  "permissions": [
    "storage",
    "tabCapture"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SoundMesh 画面延后"
  },
  "content_scripts": [
    {
      "matches": [
        "https://alloong.github.io/soundmesh/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://alloong.github.io/soundmesh/*"
      ],
      "js": [
        "delay.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "host_permissions": [
    "https://alloong.github.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "commands": {
    "send-audio": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "把当前分页的声音送到 SoundMesh"
    }
  }
}